# ====== دوّنلي — متغيّرات البيئة ======
# تطبيق ويب مستقل (PWA) — مفيش أي اعتماد على تيليجرام.

# ====== مزود الذكاء ======
# مش إجباري: لو سِبته فاضي التطبيق بيشتغل عادي وتظبّط المزود من لوحة الأدمن
# (OpenAI / Google Gemini / xAI Grok / أي مزود متوافق) — والإعدادات بتتخزّن في الداتا بيز.
OPENAI_API_KEY=

# موديلات OpenAI
# gpt-4o-transcribe: أدق بكتير في العربي من whisper-1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# موديل الـ agent (لازم يدعم tool calling كويس — لو عايز توفّر حط gpt-4o-mini)
OPENAI_AGENT_MODEL=gpt-4o
OPENAI_ANALYSIS_MODEL=gpt-4o
# ملحوظة: OPENAI_CHAT_MODEL القديم مبقاش مستخدم — امسحه من .env لو لسه موجود

# الداشبورد
PORT=3000
DASHBOARD_PASSWORD=change-me

# مسار قاعدة البيانات
DB_PATH=./data/dawenli.db

# مواعيد المبادرة (بتوقيت القاهرة)
TIMEZONE=Africa/Cairo
CHECKIN_HOUR=21
WEEKLY_DAY=5
WEEKLY_HOUR=20

# ====== إشعارات PWA (Web Push) — اختياري ======
# لو سِبتهم فاضيين، التطبيق بيتثبّت عادي بس زرار التنبيهات بيتخفي.
# ولّد مفاتيح جديدة بـ: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ====== زرار «بلّغ عن مشكلة» — اختياري ======
# البلاغات بتتبعت server-to-server لنظام بلاغات سينتاكس أكاديمي.
# المفتاح لازم يبقى نفسه في الطرفين (هناك اسمه DAWENLI_REPORT_SECRET).
# ولّد واحد بـ: openssl rand -hex 32 — من غيره الزرار بيقول إن الخدمة مش متظبطة.
REPORT_SECRET=
REPORT_URL=https://syntax.academy/api/dawenli-report
