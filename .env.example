# ====== دوّنلي — متغيّرات البيئة ======

# توكن بوت تليجرام (من @BotFather)
TELEGRAM_BOT_TOKEN=

# مفتاح OpenAI
OPENAI_API_KEY=

# الـ chat_id بتاعك انت بس (الأمان: البوت هيرد عليك انت بس)
# لو سِبته فاضي، أول مرة تكلّم البوت هيقولك الـ chat_id بتاعك
ALLOWED_CHAT_ID=

# موديلات OpenAI
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4o

# الداشبورد
PORT=3000
DASHBOARD_PASSWORD=change-me

# مسار قاعدة البيانات
DB_PATH=./data/dawenli.db
